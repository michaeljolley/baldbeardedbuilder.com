---
/*
  Your stories, and where each one stands. Email reports publication and featuring when
  enabled, but this remains the complete record, including submissions that are not
  published and therefore send no notification.

  Its own component rather than markup inside account.astro for one reason: account.astro
  needs a session and a database, so it cannot be rendered into a screenshot pass. Pulled
  out here, the real thing can be drawn with fixture data and checked in all sixteen
  themes, which is the only way this block gets looked at before somebody's first story
  lands in it.

  That pass is how two real defects were found rather than guessed at. Published and Not
  running resolved to nearly the same colour in bbb-light, and a linked title was drawn
  identically to an unlinked one. Both fixes live in app.css with the measurements beside
  them, and the marker halves are now gated by contrast.test.mjs.

  To repeat the pass: add a page under src/pages that renders this component twice, once
  with a fixture array covering all three statuses plus a published row with no slug and
  one very long title, and once with an empty array. Build, serve dist, set data-theme on
  the documentElement for each id in themes.generated.ts, and shoot at 390 and 1200.
  Delete the page afterwards. It must never ship, because it is a public route.
*/
import { submissionState, submissionTitle, type Submission } from '../lib/submissions';

interface Props {
  submissions: Submission[];
}

const { submissions } = Astro.props;
---

<div class="rule"><h2>Your stories</h2></div>

{submissions.length === 0 && (
  <p class="note">
    Nothing sent in yet. <a href="/submit/">Tell me about a dev disaster</a> and it will
    show up here with its state on it. That is how you find out what happened to it,
    because nothing gets emailed.
  </p>
)}

{submissions.length > 0 && (
  <>
    <p class="fine">
      Nothing about these is emailed to you, so this list is where you find out. Come back
      whenever.
    </p>
    <ul class="submissions">
      {submissions.map((s) => {
        const state = submissionState(s);
        const title = submissionTitle(s);
        return (
          <li class="submission">
            <p class="submission-head">
              <span class={`marker ${state.tone}`}>{state.label}</span>
              {state.href ? <a href={state.href}>{title}</a> : <span>{title}</span>}
            </p>
            <p class="fine">{state.detail}</p>
          </li>
        );
      })}
    </ul>
  </>
)}
