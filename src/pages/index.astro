---
/*
  The front page.

  Two jobs, in this order: hand somebody a story worth reading in the first screen, then
  prove there is a body of work behind it. The lead is a dev disaster rather than my
  latest post, because somebody else's worst day is a better cold open than my resume.

  Zero JavaScript. The "Another one" control is a real link to a real prerendered page
  rather than a rotator, which keeps decision 24 and decision 32 from fighting: it works
  with scripting off and it has nothing to respect prefers-reduced-motion about.
*/
import Teller from '../components/Teller.astro';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Drip from '../components/Drip.astro';
import { SITE, VISIBLE_TOPICS, sevClass, sevLabel } from '../config/site';
import { allItems, itemsInTopic } from '../lib/content';
import { starterItems, fillSpans } from '../lib/starters';
import {
  allDisasters,
  leadDisaster,
  sortDisasters,
  countsBySeverity,
  problemSummary,
  disasterCode
} from '../lib/disasters';

const items = (await allItems()).filter((i) => !i.draft);
const fresh = items.slice(0, 5);
const starters = await starterItems();
const fill = fillSpans(starters.length);

const disasters = allDisasters();
const lead = leadDisaster();
/*
  Deterministic per build rather than random per request, because the page is static.
  Stepping a third of the way through the archive keeps the second pick well away from
  the lead without needing a random number that would change on every rebuild.
*/
const another = lead
  ? disasters.filter((d) => d.id !== lead.id)[Math.floor(disasters.length / 3)]
  : undefined;
const topProblems = sortDisasters(disasters, 'liked').slice(0, 4);
const counts = countsBySeverity();

/*
  Engagement on the lead, printed only where there is any.

  A story carrying "0 likes, 0 replies" on the front page reads as a story nobody wanted,
  which is a different claim from a story nobody has found yet. Silence is the honest
  rendering of not knowing.
*/
const leadStats = lead
  ? [
      lead.likes > 0 ? `${lead.likes.toLocaleString('en-US')} likes` : null,
      lead.replies > 0 ? `${lead.replies.toLocaleString('en-US')} replies` : null
    ].filter(Boolean)
  : [];

const drips = await getCollection('drips');
drips.sort((a, b) => (a.data.publishDate < b.data.publishDate ? 1 : -1));
const latestDrip = drips[0];

const topicCounts = await Promise.all(
  VISIBLE_TOPICS.map(async (t) => ({ topic: t, n: (await itemsInTopic(t.slug)).length }))
);

const dripDay = latestDrip
  ? new Date(latestDrip.data.publishDate).toLocaleDateString('en-US', { weekday: 'short' })
  : '';
---

<Base title={SITE.name} description={SITE.tagline}>
  <main id="main">
    <section class="front shell">
      <div class="lead">
        {
          lead ? (
            <Fragment>
              <div class="lead-top">
                <span class="path">
                  dev-disasters<span class="sep">/</span>
                  <b>{disasterCode(lead.id)}</b>
                </span>
                <span class="spacer" />
                <span class={`sev ${sevClass(lead.severity)}`}>{sevLabel(lead.severity)}</span>
              </div>
              <h1>{lead.title}</h1>
              <p class="excerpt">{lead.line}</p>
              <div class="acts">
                <a class="btn primary" href={lead.url}>
                  Read the whole thing
                </a>
                {another && (
                  <a class="btn" href={another.url}>
                    &#8635; Another one
                  </a>
                )}
                <span class="by">
                  told by{' '}
                  <Teller teller={lead.teller} />
                  {leadStats.map((s) => (
                    <Fragment> &middot; {s}</Fragment>
                  ))}
                </span>
              </div>
            </Fragment>
          ) : (
            /*
              Nothing published yet. The front page still leads with dev disasters, because
              that is what this site opens with, but it asks for one instead of pretending
              to have one. No apology, no "coming soon", no empty frame where a story goes.
            */
            <Fragment>
              <div class="lead-top">
                <span class="path">dev-disasters</span>
                <span class="spacer" />
                <span class="sev sev-info">Info</span>
              </div>
              <h1>Somebody has to go first.</h1>
              <p class="excerpt">
                This is where other people's worst days live. The outage, the migration
                that ran against the wrong database, the regex that paid everybody twice.
                Nobody gets named and nobody gets dunked on.
              </p>
              <div class="acts">
                <a class="btn primary" href="/submit/">
                  Tell me yours
                </a>
                <a class="btn" href="/dev-disasters/">
                  What counts as one
                </a>
              </div>
            </Fragment>
          )
        }
        <div class="byline">
          <span class="who">I'm Michael.</span>
          <p>
            Twenty years of C# and I still find new ways to embarrass myself. I teach .NET and
            Windows development the way I learned it, out loud, on camera, mistakes included.
            <a href="/about/">More about me &rarr;</a>
          </p>
        </div>
      </div>

      <div class="side">
        <div class="rule">
          <h2>Fresh off the workbench</h2>
          <a class="more" href="/csharp/">All &rarr;</a>
        </div>
        {
          fresh.map((i) => (
            <a class="row" href={i.href} rel={i.offsite ? 'noopener' : undefined}>
              <h3>{i.title}</h3>
              <span class="meta">
                <span class="k">{i.kind === 'video' ? 'Video' : 'Article'}</span> {i.length}
                {i.offsite && <Fragment> &middot; YouTube</Fragment>}
              </span>
            </a>
          ))
        }
        {
          latestDrip && (
            <a class="row" href="https://dotnetdrip.com">
              <h3>The links that were worth reading this week</h3>
              <span class="meta">
                <span class="k">Drip</span> {dripDay}
              </span>
            </a>
          )
        }
      </div>
    </section>

    <div class="below shell">
      <div class="rule major">
        <h2>Start here</h2>
        <a class="more" href="/csharp/">Everything I've made &rarr;</a>
      </div>
      <p class="lead-in">
        New around here? The things I would hand you first, in the order I would hand
        them over.
      </p>
      <div class="grid" style={`--fill-3:${fill.three};--fill-2:${fill.two}`}>
        {
          starters.map((i, n) =>
            n === 0 ? (
              <a class="card wide" href={i.href} rel={i.offsite ? 'noopener' : undefined}>
                <span class="thumb">
                  {i.thumbnail ? (
                    <img src={i.thumbnail} alt="" width="480" height="270" loading="lazy" />
                  ) : (
                    i.length
                  )}
                </span>
                <span class="body">
                  <h3>{i.title}</h3>
                  {i.description && <p>{i.description}</p>}
                  <span class="foot">
                    <span class="k">{i.kind === 'video' ? 'Video' : 'Article'}</span> {i.topic}{' '}
                    &middot; {i.length}
                    {i.offsite && <Fragment> &middot; YouTube</Fragment>}
                  </span>
                </span>
              </a>
            ) : (
              <a class="card" href={i.href} rel={i.offsite ? 'noopener' : undefined}>
                <h3>{i.title}</h3>
                {i.description && <p>{i.description}</p>}
                <span class="foot">
                  <span class="k">{i.kind === 'video' ? 'Video' : 'Article'}</span> {i.topic}{' '}
                  &middot; {i.length}
                  {i.offsite && <Fragment> &middot; YouTube</Fragment>}
                </span>
              </a>
            )
          )
        }
      </div>

      <div class="rule major"><h2>Learning paths</h2></div>
      <p class="lead-in">
        Pick a rabbit hole. Each one is everything I've made on that topic, in the order
        that actually makes sense to read it.
      </p>
      <div class="chips">
        {
          topicCounts
            .filter((t) => t.n > 0)
            .map((t) => (
              <a class="chip" href={`/${t.topic.slug}/`}>
                {t.topic.label} <span class="n">{t.n}</span>
              </a>
            ))
        }
      </div>

      <div class="rule major">
        <h2>Dev disasters</h2>
        <a class="more" href="/dev-disasters/">{counts.all > 0 ? `All ${counts.all} ` : 'All '}&rarr;</a>
      </div>
      <p class="lead-in">Other people's worst days, filed by how bad it got.</p>
      <div class="panel">
        <div class="panel-bar">
          <span>Problems</span>
          <span class="count">{problemSummary()}</span>
        </div>
        {
          topProblems.map((d) => (
            <a class="prow" href={d.url}>
              <span class={`sev ${sevClass(d.severity)}`}>{sevLabel(d.severity)}</span>
              <span class="msg">{d.line}</span>
              <span class="loc">
                #{disasterCode(d.id)}
                {d.likes > 0 && <Fragment> &middot; &#9825; {d.likes.toLocaleString('en-US')}</Fragment>}
              </span>
            </a>
          ))
        }
        {
          topProblems.length === 0 && (
            <a class="prow" href="/submit/">
              <span class="sev sev-info">Info</span>
              <span class="msg">No problems reported. Yours would be the first.</span>
              <span class="loc">#000</span>
            </a>
          )
        }
      </div>

      <div class="story-cta">
        <a class="btn primary" href="/submit/">Tell me yours</a>
        <span class="fine">Post anonymously if you'd rather. No name is ever required.</span>
      </div>

      <div class="rule major" id="drip"><h2>The .NET Drip</h2></div>
      <Drip uid="home" />
    </div>
  </main>
</Base>
